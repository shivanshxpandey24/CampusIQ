generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  FACULTY
  STUDENT
  PARENT
  HOSTEL_WARDEN
  TRANSPORT_MANAGER
  ACCOUNTANT
  HELPDESK_STAFF
}

enum Module {
  STUDENTS
  ACADEMICS
  ATTENDANCE
  TIMETABLE
  FEES
  HOSTEL
  TRANSPORT
  CERTIFICATES
  HELPDESK
  NOTIFICATIONS
  REPORTS
}

model Campus {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  users     User[]
  records   CampusRecord[]
  createdAt DateTime        @default(now())
}

model User {
  id           String         @id @default(cuid())
  campusId     String
  campus       Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         Role
  createdAt    DateTime       @default(now())
  records       CampusRecord[] @relation("RecordCreator")
  student       Student?
  @@unique([campusId, email])
  @@index([campusId, role])
}

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber  String   @unique
  program        String
  year           Int
  parentEmail    String?
  createdAt      DateTime @default(now())
}

model CampusRecord {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  module      Module
  title       String
  description String   @default("")
  status      String   @default("Open")
  amount      Decimal? @db.Decimal(12, 2)
  dueDate     DateTime?
  fields      Json     @default("{}")
  createdById String?
  createdBy   User?    @relation("RecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([campusId, module, createdAt])
  @@index([campusId, status])
}
